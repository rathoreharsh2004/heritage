# Server Configuration
PORT=5000

# MongoDB Connection
# Examples:
# Local: mongodb://127.0.0.1:27017/rathore_heritage
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/rathore_heritage?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/rathore_heritage

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Default Initial Admin Credentials (for seed script)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@rathoreheritage.com
INITIAL_ADMIN_PASSWORD=Admin@123456

# Client / CORS URLs
CLIENT_URL=http://localhost:5000

